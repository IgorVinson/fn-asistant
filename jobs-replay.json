o and Save. A Problem Report will be created requesting the label.\n\n**General Rules**: - Return all returnable unused parts and all returnable used parts to FedEx with 24 hours of Check Out. - Parts belong to AVT/Shyft Services. - Do not leave parts onsite. Parts left onsite are subject to an Admin Process fee.","actions":[]},"isRequestedWindow":false,"time":{"start":"2026-10-22T11:48","end":"2026-10-22T19:00"},"payRange":{"min":80,"max":80},"payType":"fixed","payStructure":null,"hourlyRate":0,"estLaborHours":1.75,"distance":15.173736920924137},"result":{"eligible":false,"counterOffer":null,"reason":"WO_IN_PAST","rejectDetails":"Requested start 10/22/2026, 11:48:00 AM is in the past"},"availableBlocks":[{"start":"2026-10-23T19:00:00.000Z","end":"2026-10-24T00:00:00.000Z"},{"start":"2026-10-26T13:00:00.000Z","end":"2026-10-26T13:30:00.000Z"},{"start":"2026-10-26T19:00:00.000Z","end":"2026-10-27T00:00:00.000Z"}],"busyBlocks":[{"start":"2026-10-22T13:00:00.000Z","end":"2026-10-22T17:30:00.000Z","summary":"Granite"},{"start":"2026-10-23T13:00:00.000Z","end":"2026-10-23T19:00:00.000Z","summary":"Ericcson"},{"start":"2026-10-26T13:30:00.000Z","end":"2026-10-26T19:00:00.000Z","summary":"Epik"},{"start":"2026-10-22T17:30:00.000Z","end":"2026-10-23T00:30:00.000Z","summary":"Fair festival"},{"start":"2026-10-23T02:00:00.000Z","end":"2026-10-23T03:00:00.000Z","summary":"Pay Bills"},{"start":"2026-10-26T15:00:00.000Z","end":"2026-10-26T18:00:00.000Z","summary":"🔧 05899945 Toyota TBMNC EPIK Install Revisit (WM)"},{"start":"2026-10-28T14:00:00.000Z","end":"2026-10-28T17:00:00.000Z","summary":"🔧 05974878-The Warehouse-EPIK Survey (WM)"},{"start":"2026-10-28T17:00:00.000Z","end":"2026-10-28T21:00:00.000Z","summary":"🔧 Trinity Lower School (WM)"},{"start":"2026-10-28T17:01:00.000Z","end":"2026-10-28T21:01:00.000Z","summary":"🔧 Trinity Gym (WM)"},{"start":"2026-10-28T17:00:00.000Z","end":"2026-10-28T21:00:00.000Z","summary":"🔧 Trinity South Building (WM)"},{"start":"2026-10-28T17:0