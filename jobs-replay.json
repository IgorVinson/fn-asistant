{"job":{"id":"6414680454","platform":"WorkMarket","company":"DataMax Services, Inc","title":"USY8-NC-Four Seasons Miniso SVC RET","description":"<p>Complete MINISO retrofit technology installation for the assigned store.</p><p><br></p><p>General scope includes cabling, rack/device placement, patch panel connections, device/cable labeling, cash wrap POS/Clover connections, AP/TV/media cabling, NVR/BDCOM/camera patching if assigned, Sangoma testing support, and closeout photo documentation. Removing old equipment</p><p><br></p><p>Technician must follow the attached MINISO Retrofit Install Guide and the assigned V11 port map.</p><p><br></p><p>Must Bring a Laptop</p><p>Must Bring no less than 500' of WHITE Cat 6 for 2-3 cable runs.</p>","isRequestedWindow":false,"time":{"start":"2026-09-08T13:00","end":"2026-09-08T32:30"},"payRange":{"min":70,"max":1415},"payType":"hourly","payStructure":null,"hourlyRate":70,"estLaborHours":19.5,"distance":65.3},"result":{"eligible":false,"counterOffer":null,"reason":"BLOCKED_KEYWORD","rejectDetails":"Blocked keyword \"TV\" in description"},"availableBlocks":[{"start":"2026-09-09T00:00:00.000Z","end":"2026-09-09T00:00:00.000Z"},{"start":"2026-09-10T00:00:00.000Z","end":"2026-09-10T00:00:00.000Z"},{"start":"2026-09-10T13:00:00.000Z","end":"2026-09-10T17:00:00.000Z"},{"start":"2026-09-10T21:00:00.000Z","end":"2026-09-11T00:00:00.000Z"},{"start":"2026-09-11T13:00:00.000Z","end":"2026-09-11T16:00:00.000Z"},{"start":"2026-09-12T00:00:00.000Z","end":"2026-09-12T00:00:00.000Z"}],"busyBlocks":[{"start":"2026-09-08T12:30:00.000Z","end":"2026-09-08T18:30:00.000Z","summary":"Epik"},{"start":"2026-09-08T18:30:00.000Z","end":"2026-09-09T00:00:00.000Z","summary":"Miniso day 1"},{"start":"2026-09-09T12:30:00.000Z","end":"2026-09-09T18:30:00.000Z","summary":"Epik"},{"start":"2026-09-09T18:30:00.000Z","end":"2026-09-10T00:00:00.000Z","summary":"Miniso day 2"},{"start":"2026-09-10T17:00:00.000Z","end":"2026-09-10T21:00:00.000Z","summary":"Gap"},{"start":