 Screwdrivers and security bits\n- Patch cables\n- Regular Cat5e Ethernet cable\n- Cisco console cable\n- Serial cables\n- Working serial-to-USB adapter\n- Putty software\n- Digital multimeter\n- Loopback adapter\n- Tone and probe kit\n- Cable verification tester (Microscanner or equivalent)\n- Cable certifier (copper/fiber)\n- Visual fault locator\n- Laptop with local administrator privileges\n- Punch-down tool\n- Cellular hotspot\n- Extra connectors\n- USB-C to USB-A adapters\n- USB-A to RJ45 console cable\n- Additional network troubleshooting tools as required for the scope of work.","actions":[]},"isRequestedWindow":false,"time":{"start":"2026-10-02T12:00","end":"2026-10-02T17:00"},"payRange":{"min":50,"max":250},"payType":"hourly","payStructure":null,"hourlyRate":50,"estLaborHours":5,"distance":5},"result":{"eligible":false,"counterOffer":{"shouldCounterOffer":true,"payType":"hourly","counterRate":60,"baseAmount":300,"estHours":5,"travelExpense":0,"payStructure":null,"counterDate":{"start":"2026-10-06T18:00:00.000Z","end":"2026-10-06T19:00:00.000Z","durationMinutes":60,"mode":"hours","reason":"arrival_window"}},"reason":"COUNTER_DATES"},"availableBlocks":[{"start":"2026-10-02T13:00:00.000Z","end":"2026-10-02T15:00:00.000Z"},{"start":"2026-10-02T20:00:00.000Z","end":"2026-10-03T00:00:00.000Z"},{"start":"2026-10-05T13:00:00.000Z","end":"2026-10-05T14:00:00.000Z"},{"start":"2026-10-06T18:00:00.000Z","end":"2026-10-07T00:00:00.000Z"}],"busyBlocks":[{"start":"2026-10-02T15:00:00.000Z","end":"2026-10-02T20:00:00.000Z","summary":"Busy"},{"start":"2026-10-06T15:00:00.000Z","end":"2026-10-06T18:00:00.000Z","summary":"Workmarket Roma ticket"},{"start":"2026-10-07T13:30:00.000Z","end":"2026-10-07T17:30:00.000Z","summary":"🔧 Equipment Install | Priority 3 | 10/07/2026 | Hard Start (WM)"},{"start":"2026-10-02T15:00:00.000Z","end":"2026-10-02T19:00:00.000Z","summary":"🔧 04301368 || 8460 Times Dispatch Blvd || EPIK Cutover and Test (WM)"},{"start":"2026-10-12T13:00:00.000Z","