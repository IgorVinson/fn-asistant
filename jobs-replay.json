ipment Needed:**\n\nLaptop/console cable with power supply\n\nCell phone with charger and earbuds","actions":[]},"isRequestedWindow":false,"time":{"start":"2026-11-18T16:00","end":"2026-11-18T18:00"},"payRange":{"min":65,"max":130},"payType":"hourly","payStructure":null,"hourlyRate":65,"estLaborHours":2,"distance":21.954278885458372},"result":{"eligible":false,"counterOffer":null,"reason":"PAYMENT_BELOW_MINIMUM","rejectDetails":"Total pay $130 (countered: $130) is below minimum threshold $450"},"availableBlocks":[{"start":"2026-11-20T14:00:00.000Z","end":"2026-11-21T01:00:00.000Z"}],"busyBlocks":[{"start":"2026-11-18T05:00:00.000Z","end":"2026-11-20T05:00:00.000Z","summary":"2 day Raleigh office"},{"start":"2026-11-23T03:00:00.000Z","end":"2026-11-23T04:00:00.000Z","summary":"Pay Bills"},{"start":"2026-12-01T13:00:00.000Z","end":"2026-12-01T15:00:00.000Z","summary":"🔧 AXON - Wilson Police Department - NC (WM)"},{"start":"2026-11-10T21:30:00.000Z","end":"2026-11-11T00:30:00.000Z","summary":"🔧 ***Thermo Fisher | Network Cutover Assistance*** (WM)"},{"start":"2026-11-17T15:00:00.000Z","end":"2026-11-17T18:00:00.000Z","summary":"🔧 The Preiss Company-05974911-Epik Cutover & Test (WM)"},{"start":"2026-11-16T21:30:00.000Z","end":"2026-11-17T00:30:00.000Z","summary":"🔧 Advance Auto Parts - Phone Swap - 4810 Raleigh  NC (WM)"},{"start":"2026-11-17T17:30:00.000Z","end":"2026-11-17T20:30:00.000Z","summary":"🔧 Rollins/Orkin Pest Control - FortiGate Swap & edgebootPro installation - Raleigh, NC (WM)"},{"start":"2026-12-08T14:00:00.000Z","end":"2026-12-08T22:00:00.000Z","summary":"Large Financial Institution | Device Refresh | High Volume Opportunity"},{"start":"2026-11-16T14:00:00.000Z","end":"2026-11-16T20:00:00.000Z","summary":"[INC#: WO 2026 Nov 16 SITE#: RTP/DC3]   To Be Updated"},{"start":"2026-11-13T14:00:00.000Z","end":"2026-11-13T20:00:00.000Z","summary":"[INC#: 00740402 - ATT SITE#: RTP/DC3]   To Be Updated"},{"start":"2026-11-11T13:00:00.000Z","end":"2026-11-11T20:00:0