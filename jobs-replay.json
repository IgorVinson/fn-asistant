tances by emailing lexmarkprojects@parkplacetech.com will ensure we are notified quickly.","actions":[]},"isRequestedWindow":true,"time":{"start":"2026-11-11T09:00","end":"2026-11-11T12:00","latestStart":"2026-11-11T12:00"},"payRange":{"min":85,"max":170},"payType":"fixed","payStructure":null,"hourlyRate":0,"estLaborHours":3,"distance":44.830079383758004},"result":{"eligible":false,"counterOffer":null,"reason":"PAYMENT_BELOW_MINIMUM","rejectDetails":"Total pay $170 is below minimum threshold $450"},"availableBlocks":[{"start":"2026-11-12T14:00:00.000Z","end":"2026-11-12T22:00:00.000Z"},{"start":"2026-11-12T23:00:00.000Z","end":"2026-11-13T01:00:00.000Z"},{"start":"2026-11-13T14:00:00.000Z","end":"2026-11-14T01:00:00.000Z"}],"busyBlocks":[{"start":"2026-11-12T22:00:00.000Z","end":"2026-11-12T23:00:00.000Z","summary":"Pay bills BoA + Amex"},{"start":"2026-11-11T05:00:00.000Z","end":"2026-11-12T05:00:00.000Z","summary":"Veterans Day"},{"start":"2026-11-05T17:00:00.000Z","end":"2026-11-05T22:00:00.000Z","summary":"🔧 Equipment Install | Priority 3 | 11/05/2026 | Hard Start (WM)"},{"start":"2026-11-16T21:30:00.000Z","end":"2026-11-17T00:30:00.000Z","summary":"🔧 Advance Auto Parts - Phone Swap - 4810 Raleigh  NC (WM)"},{"start":"2026-11-10T21:30:00.000Z","end":"2026-11-11T00:30:00.000Z","summary":"🔧 ***Thermo Fisher | Network Cutover Assistance*** (WM)"},{"start":"2026-11-05T14:00:00.000Z","end":"2026-11-05T17:00:00.000Z","summary":"🔧 ***Thermo Fisher Scientific | WAN Activations Assistance*** (WM)"},{"start":"2026-11-06T14:00:00.000Z","end":"2026-11-06T17:00:00.000Z","summary":"🔧 04048455-Humacyte INC-EPIK Survey and Install (WM)"},{"start":"2026-11-17T17:30:00.000Z","end":"2026-11-17T20:30:00.000Z","summary":"🔧 Rollins/Orkin Pest Control - FortiGate Swap & edgebootPro installation - Raleigh, NC (WM)"},{"start":"2026-11-09T19:30:00.000Z","end":"2026-11-09T22:30:00.000Z","summary":"🔧 Rollins/Orkin Pest Control - FortiGate Swap & edgebootPro installation - Raleigh, NC (WM)"