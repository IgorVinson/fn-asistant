{"job":{"id":"9243970381","platform":"WorkMarket","company":"VISTA COMMUNICATIONS INC","title":"Cable/PhoneTechnician","description":"<p>Troubleshoot the phone system issue and terminate cables help of Lead Remote tech. Must have butt sett, RJ11 connectors, prior telecom/pbx experience and work with Lead remote tech.Tech must have a Laptop with serial port and connector</p><p><br></p><p><br></p><p>Any job more than 6 hours, 30 mins of lunch time will be deducted.</p>","isRequestedWindow":false,"time":{"start":"2026-10-16T09:00","end":"2026-10-16T12:00"},"payRange":{"min":35,"max":105},"payType":"hourly","payStructure":null,"hourlyRate":35,"estLaborHours":3,"distance":0},"result":{"eligible":false,"counterOffer":{"shouldCounterOffer":true,"payType":"hourly","counterRate":65,"baseAmount":195,"estHours":3,"travelExpense":0,"payStructure":null,"counterDate":{"start":"2026-10-16T18:00:00.000Z","end":"2026-10-16T19:00:00.000Z","durationMinutes":60,"mode":"hours","reason":"arrival_window"}},"reason":"COUNTER_DATES"},"availableBlocks":[{"start":"2026-10-16T18:00:00.000Z","end":"2026-10-17T00:00:00.000Z"},{"start":"2026-10-19T19:30:00.000Z","end":"2026-10-20T00:00:00.000Z"},{"start":"2026-10-20T13:00:00.000Z","end":"2026-10-21T00:00:00.000Z"}],"busyBlocks":[{"start":"2026-10-19T13:00:00.000Z","end":"2026-10-19T19:30:00.000Z","summary":"Epik"},{"start":"2026-10-22T13:00:00.000Z","end":"2026-10-22T19:00:00.000Z","summary":"🔧 ***Burlington | WAN Testing/Validation, EB Install, Cross Connect Assistance*** (WM)"},{"start":"2026-10-19T15:00:00.000Z","end":"2026-10-19T18:00:00.000Z","summary":"🔧 Signature Aviation - Install - GSO 1060 PTI Drive, Greensboro, NC 27409 (WM)"},{"start":"2026-10-16T12:00:00.000Z","end":"2026-10-16T18:00:00.000Z","summary":"[INC#: 00736667 - ATT SITE#: RTP/DC3]   To Be Updated"},{"start":"2026-10-15T12:00:00.000Z","end":"2026-10-15T18:00:00.000Z","summary":"[INC#: 00736663 - ATT SITE#: RTP/DC3]   To Be Updated"},{"start":"2026-10-14T12:00:00.000Z","end":