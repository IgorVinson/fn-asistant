bility for future assignments.**\n\nScope: Request dispatch for Network install, Requesting all network hardware to be mounted and installed in network rack. (Aruba Gateway, 2 Aruba Switches, DIGI, connect patch cables from patch panel to switch, mount Wireless AP's in ceiling and install APC UPS in network rack.\n\nSPOC: Brandon Andrews -2527142258\n\nRemote poc: Ron Ramseur - 678-331-3550 and Aric Arnsworth - 781-516-7287.\n\nThe NS&I support engineer for this one will be Antonio Medeiros 781-697-6933.","actions":[]},"isRequestedWindow":false,"time":{"start":"2026-09-30T09:00","end":"2026-09-30T17:00"},"payRange":{"min":40,"max":320},"payType":"hourly","payStructure":null,"hourlyRate":40,"estLaborHours":8,"distance":50},"result":{"eligible":false,"counterOffer":{"shouldCounterOffer":true,"payType":"hourly","counterRate":60,"baseAmount":480,"estHours":8,"travelExpense":75,"payStructure":null},"reason":"PAYMENT_INSUFFICIENT","rejectDetails":"Rate $40/hr is below base rate $60/hr"},"availableBlocks":[{"start":"2026-09-30T13:00:00.000Z","end":"2026-10-01T00:00:00.000Z"},{"start":"2026-10-01T13:00:00.000Z","end":"2026-10-02T00:00:00.000Z"},{"start":"2026-10-02T13:00:00.000Z","end":"2026-10-03T00:00:00.000Z"}],"busyBlocks":[{"start":"2026-09-29T13:00:00.000Z","end":"2026-09-29T20:00:00.000Z","summary":"🔧 Site Audit | Priority 3 | 09/29/2026 04:00:00 - 07:00:00 GMT-4 | Requested Window (WM)"},{"start":"2026-09-25T12:00:00.000Z","end":"2026-09-26T00:00:00.000Z","summary":"🔧 Budderfly - 162218 - MCD-11779 - MAX (WM)"},{"start":"2026-10-15T14:00:00.000Z","end":"2026-10-15T17:00:00.000Z","summary":"🔧 02207602 + Swarovksi - Swarovski #63 + epik cutover / revisit (WM)"},{"start":"2026-10-05T14:00:00.000Z","end":"2026-10-05T17:00:00.000Z","summary":"🔧 05974921-University Glen-EPIK Survey (WM)"},{"start":"2026-10-15T17:00:00.000Z","end":"2026-10-15T20:00:00.000Z","summary":"🔧 05974915-The Edition on Rosemary-EPIK Survey (WM)"},{"start":"2026-09-22T19:30:00.000Z","end":"2026-09-2