tances by emailing lexmarkprojects@parkplacetech.com will ensure we are notified quickly.","actions":[]},"isRequestedWindow":true,"time":{"start":"2026-12-08T09:00","end":"2026-12-08T15:00","latestStart":"2026-12-08T14:00"},"payRange":{"min":75,"max":300},"payType":"fixed","payStructure":null,"hourlyRate":0,"estLaborHours":6,"distance":8.893027843101779},"result":{"eligible":false,"counterOffer":null,"reason":"PAYMENT_BELOW_MINIMUM","rejectDetails":"Total pay $300 is below minimum threshold $450"},"availableBlocks":[{"start":"2026-12-08T14:00:00.000Z","end":"2026-12-09T01:00:00.000Z"},{"start":"2026-12-09T14:00:00.000Z","end":"2026-12-10T01:00:00.000Z"},{"start":"2026-12-10T14:00:00.000Z","end":"2026-12-11T01:00:00.000Z"},{"start":"2026-12-11T14:00:00.000Z","end":"2026-12-12T01:00:00.000Z"}],"busyBlocks":[{"start":"2026-12-12T22:00:00.000Z","end":"2026-12-12T23:00:00.000Z","summary":"Pay bills BoA + Amex"},{"start":"2026-10-27T14:00:00.000Z","end":"2026-10-27T18:00:00.000Z","summary":"🔧 04546900 Preiss Co View at Legacy Oaks Cutover/Test Install Wizard (WM)"},{"start":"2026-11-17T17:30:00.000Z","end":"2026-11-17T20:30:00.000Z","summary":"🔧 Rollins/Orkin Pest Control - FortiGate Swap & edgebootPro installation - Raleigh, NC (WM)"},{"start":"2026-11-09T19:30:00.000Z","end":"2026-11-09T22:30:00.000Z","summary":"🔧 Rollins/Orkin Pest Control - FortiGate Swap & edgebootPro installation - Raleigh, NC (WM)"},{"start":"2026-10-28T14:00:00.000Z","end":"2026-10-28T17:00:00.000Z","summary":"🔧 05974878-The Warehouse-EPIK Survey (WM)"},{"start":"2026-10-28T17:00:00.000Z","end":"2026-10-28T21:00:00.000Z","summary":"🔧 Trinity Lower School (WM)"},{"start":"2026-10-28T17:01:00.000Z","end":"2026-10-28T21:01:00.000Z","summary":"🔧 Trinity Gym (WM)"},{"start":"2026-10-28T17:00:00.000Z","end":"2026-10-28T21:00:00.000Z","summary":"🔧 Trinity South Building (WM)"},{"start":"2026-10-28T17:01:00.000Z","end":"2026-10-28T21:01:00.000Z","summary":"🔧 Trinity Arts Engineering (WM)"},{"start":"2026-