s within ten (10) days of Work Order completion.**\n\n***\\*\\*Photos of the office monitor showing cameras view from both Before AND After are REQUIRED***\n\n***\\*\\*Capture of manager signature to certify work completion and they approve the view is REQUIRED***","actions":[]},"isRequestedWindow":true,"time":{"start":"2026-11-10T08:00","end":"2026-11-10T09:00","latestStart":"2026-11-10T17:00"},"payRange":{"min":75,"max":75},"payType":"hourly","payStructure":null,"hourlyRate":75,"estLaborHours":1,"distance":12.256934654743137},"result":{"eligible":false,"counterOffer":null,"reason":"BLOCKED_KEYWORD","rejectDetails":"Blocked keyword \"monitor\" in description"},"availableBlocks":[{"start":"2026-11-10T14:00:00.000Z","end":"2026-11-10T15:00:00.000Z"},{"start":"2026-11-10T18:00:00.000Z","end":"2026-11-10T21:30:00.000Z"},{"start":"2026-11-11T00:30:00.000Z","end":"2026-11-11T01:00:00.000Z"},{"start":"2026-11-12T14:00:00.000Z","end":"2026-11-12T14:30:00.000Z"},{"start":"2026-11-12T23:30:00.000Z","end":"2026-11-13T01:00:00.000Z"},{"start":"2026-11-13T20:00:00.000Z","end":"2026-11-14T01:00:00.000Z"}],"busyBlocks":[{"start":"2026-11-10T15:00:00.000Z","end":"2026-11-10T18:00:00.000Z","summary":"Granite"},{"start":"2026-11-12T14:30:00.000Z","end":"2026-11-12T23:30:00.000Z","summary":"Progitech"},{"start":"2026-11-13T14:00:00.000Z","end":"2026-11-13T20:00:00.000Z","summary":"Ericsson"},{"start":"2026-11-12T22:00:00.000Z","end":"2026-11-12T23:00:00.000Z","summary":"Pay bills BoA + Amex"},{"start":"2026-11-11T05:00:00.000Z","end":"2026-11-12T05:00:00.000Z","summary":"Veterans Day"},{"start":"2026-11-17T15:00:00.000Z","end":"2026-11-17T18:00:00.000Z","summary":"🔧 The Preiss Company-05974911-Epik Cutover & Test (WM)"},{"start":"2026-11-10T15:00:00.000Z","end":"2026-11-10T18:00:00.000Z","summary":"🔧 05636592 - 1013 Classic Rd | VTM CUT (WM)"},{"start":"2026-11-10T21:30:00.000Z","end":"2026-11-11T00:30:00.000Z","summary":"🔧 ***Thermo Fisher | Network Cutover Assistance*** (WM)"},{"st