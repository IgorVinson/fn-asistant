{"job":{"id":20064986,"platform":"FieldNation","company":"Brandpoint Services","title":"2 Techs Needed - Menu Board Swap, configuration and drop off","description":{"html":"<p>We are swapping out a defective display for a new one.</p><p>Team must check in and out with Brandpoint support.</p><p>We are taking the defective unit and packing it in the new box, and will be dropping it off at a local fedex the same/next business day.</p><p>After Replacement call support to ensure content is up on the new screen.</p><p>Photos and Sign off paper needed before leaving site.</p><p>Photo of drop off receipt needed.(boxes are large so need a large SUV, van or pickup)</p><p>MUST HAVE TORX SECURITY BITS/SCREWDRIVERS</p>","markdown":"We are swapping out a defective display for a new one.\n\nTeam must check in and out with Brandpoint support.\n\nWe are taking the defective unit and packing it in the new box, and will be dropping it off at a local fedex the same/next business day.\n\nAfter Replacement call support to ensure content is up on the new screen.\n\nPhotos and Sign off paper needed before leaving site.\n\nPhoto of drop off receipt needed.(boxes are large so need a large SUV, van or pickup)\n\nMUST HAVE TORX SECURITY BITS/SCREWDRIVERS","actions":[]},"isRequestedWindow":true,"time":{"start":"2026-09-30T13:00","end":"2026-09-30T15:00","latestStart":"2026-09-30T14:00"},"payRange":{"min":200,"max":200},"payType":"fixed","payStructure":null,"hourlyRate":0,"estLaborHours":2,"distance":59},"result":{"eligible":false,"counterOffer":{"shouldCounterOffer":true,"payType":"fixed","counterRate":100,"baseAmount":200,"estHours":2,"travelExpense":90,"payStructure":null,"counterDate":{"start":"2026-10-01T17:00:00.000Z","end":"2026-10-01T18:00:00.000Z","durationMinutes":60,"mode":"hours"}},"reason":"COUNTER_DATES"},"availableBlocks":[{"start":"2026-09-30T13:00:00.000Z","end":"2026-09-30T15:30:00.000Z"},{"start":"2026-09-30T20:30:00.000Z","end":"2026-10-01T00:00:00.000Z"},{"start":"2026-10-01