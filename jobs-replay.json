{"job":{"id":20095944,"platform":"FieldNation","company":"Pomeroy","title":"Troubleshooting LED Wall - Scope 3 hrs","description":{"html":"<p>Scope of work: Troubleshoot an LED wall</p><p>Tech will need to check in with coordinator</p><p>Tech will need to bring a cable tester</p><p>Tech will need to check the wiring in the LED cabinets</p><p>Tech will need to assist in troubleshooting any other issues with the LED wall</p><p>Tech will need to send pictures to coordinator before they can be checked out</p><p>Tech will need to check out with the coordinator</p>","markdown":"Scope of work: Troubleshoot an LED wall\n\nTech will need to check in with coordinator\n\nTech will need to bring a cable tester\n\nTech will need to check the wiring in the LED cabinets\n\nTech will need to assist in troubleshooting any other issues with the LED wall\n\nTech will need to send pictures to coordinator before they can be checked out\n\nTech will need to check out with the coordinator","actions":[]},"isRequestedWindow":false,"time":{"start":"2026-10-05T11:00","end":"2026-10-05T14:00"},"payRange":{"min":45,"max":135},"payType":"hourly","payStructure":null,"hourlyRate":45,"estLaborHours":3,"distance":32.21120092522259},"result":{"eligible":false,"counterOffer":{"shouldCounterOffer":true,"payType":"hourly","counterRate":60,"baseAmount":180,"estHours":3,"travelExpense":55,"payStructure":null,"counterDate":{"start":"2026-10-06T18:00:00.000Z","end":"2026-10-06T19:00:00.000Z","durationMinutes":60,"mode":"hours","reason":"arrival_window"}},"reason":"COUNTER_DATES"},"availableBlocks":[{"start":"2026-10-05T13:00:00.000Z","end":"2026-10-05T16:30:00.000Z"},{"start":"2026-10-06T18:00:00.000Z","end":"2026-10-07T00:00:00.000Z"},{"start":"2026-10-07T17:30:00.000Z","end":"2026-10-08T00:00:00.000Z"},{"start":"2026-10-08T13:00:00.000Z","end":"2026-10-09T00:00:00.000Z"},{"start":"2026-10-09T13:00:00.000Z","end":"2026-10-09T14:00:00.000Z"},{"start":"2026-10-09T20:30:00.000Z","end":"2026-10-10T00:00:00.000