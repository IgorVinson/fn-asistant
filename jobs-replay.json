oved by calling \\*\\*\\*\\*\\*\\*\\*\\*\\*\\*\\*\\*. If approved, the Buyer \\*\\*\\*\\* \\*\\*\\*\\*\\*\\*\\*\\*\\*\\*\\*\\*\\*\\*\\* will document the additional approved time in the messages of the Field Nation portal.","actions":[]},"isRequestedWindow":false,"time":{"start":"2026-10-15T06:00","end":"2026-10-15T08:00"},"payRange":{"min":70,"max":140},"payType":"hourly","payStructure":null,"hourlyRate":70,"estLaborHours":2,"distance":59.92650623488999},"result":{"eligible":false,"counterOffer":null,"reason":"PAYMENT_BELOW_MINIMUM","rejectDetails":"Total pay $140 (countered: $140) is below minimum threshold $300"},"availableBlocks":[{"start":"2026-10-19T13:00:00.000Z","end":"2026-10-20T00:00:00.000Z"}],"busyBlocks":[{"start":"2026-10-12T04:00:00.000Z","end":"2026-10-18T04:00:00.000Z","summary":"Durham RTP"},{"start":"2026-10-09T14:00:00.000Z","end":"2026-10-09T22:00:00.000Z","summary":"🔧 05809722 - VEG - Cary NC - Managed Starlink Survey (WM)"},{"start":"2026-10-28T14:00:00.000Z","end":"2026-10-28T17:00:00.000Z","summary":"🔧 05974878-The Warehouse-EPIK Survey (WM)"},{"start":"2026-10-26T14:00:00.000Z","end":"2026-10-26T17:00:00.000Z","summary":"🔧 04546900 Preiss Co View at Legacy Oaks Cutover/Test Install Wizard (WM)"},{"start":"2026-10-21T14:00:00.000Z","end":"2026-10-21T17:00:00.000Z","summary":"🔧 05974912-Red Wolf Crossing-EPIK Survey (WM)"},{"start":"2026-10-14T18:00:00.000Z","end":"2026-10-14T21:00:00.000Z","summary":"🔧 05974903-Method Townhomes-EPIK Survey (WM)"},{"start":"2026-10-15T18:00:00.000Z","end":"2026-10-15T21:00:00.000Z","summary":"🔧 05980771-The Edition on Oberlin-EPIK Survey (WM)"},{"start":"2026-10-15T14:00:00.000Z","end":"2026-10-15T17:00:00.000Z","summary":"🔧 02207602 + Swarovksi - Swarovski #63 + epik cutover / revisit (WM)"},{"start":"2026-10-15T17:00:00.000Z","end":"2026-10-15T20:00:00.000Z","summary":"🔧 05974915-The Edition on Rosemary-EPIK Survey (WM)"},{"start":"2026-10-16T12:00:00.000Z","end":"2026-10-16T18:00:00.000Z","summary":"[INC#: