bsequent days scheduled will be considered ?Cancelled?, not ?Aborted?.  <br><br>All site aborts MUST be approved by ServicePoint.","isRequestedWindow":false,"time":{"start":"2026-09-25T12:00","end":"2026-09-25T16:00"},"payRange":{"min":0,"max":100},"payType":"fixed","payStructure":null,"hourlyRate":0,"estLaborHours":4,"distance":9.3},"result":{"eligible":false,"counterOffer":null,"reason":"PAYMENT_BELOW_MINIMUM","rejectDetails":"Total pay $100 is below minimum threshold $450"},"availableBlocks":[{"start":"2026-09-25T19:00:00.000Z","end":"2026-09-26T00:00:00.000Z"},{"start":"2026-09-28T13:00:00.000Z","end":"2026-09-29T00:00:00.000Z"},{"start":"2026-09-29T13:00:00.000Z","end":"2026-09-30T00:00:00.000Z"}],"busyBlocks":[{"start":"2026-09-25T12:00:00.000Z","end":"2026-09-25T19:00:00.000Z","summary":"Ortodont Dana"},{"start":"2026-09-30T14:00:00.000Z","end":"2026-09-30T17:00:00.000Z","summary":"🔧 05974903-Method Townhomes-EPIK Survey (WM)"},{"start":"2026-10-02T14:00:00.000Z","end":"2026-10-02T17:00:00.000Z","summary":"🔧 05974912-Red Wolf Crossing-EPIK Survey (WM)"},{"start":"2026-09-21T14:01:00.000Z","end":"2026-09-21T18:01:00.000Z","summary":"🔧 04546900 Preiss Co View at Legacy Oaks Cutover/Test Install Wizard (WM)"},{"start":"2026-10-05T14:00:00.000Z","end":"2026-10-05T17:00:00.000Z","summary":"🔧 05974921-University Glen-EPIK Survey (WM)"},{"start":"2026-09-22T14:00:00.000Z","end":"2026-09-22T17:00:00.000Z","summary":"🔧 05980771-The Edition on Oberlin-EPIK Survey (WM)"},{"start":"2026-10-15T17:00:00.000Z","end":"2026-10-15T20:00:00.000Z","summary":"🔧 05974915-The Edition on Rosemary-EPIK Survey (WM)"},{"start":"2026-09-16T14:00:00.000Z","end":"2026-09-16T17:00:00.000Z","summary":"🔧 05974878-The Warehouse-EPIK Survey (WM)"},{"start":"2026-09-21T12:00:00.000Z","end":"2026-09-21T14:00:00.000Z","summary":"🔧 USK8 NC-Jacksonville Mall Miniso Retro (WM)"},{"start":"2026-09-18T13:00:00.000Z","end":"2026-09-18T21:00:00.000Z","summary":"Experienced L3 network tech needed to work