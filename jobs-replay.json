 you risk delay or completely forfeit all compensation.*","actions":[]},"isRequestedWindow":false,"time":{"start":"2026-11-06T13:00","end":"2026-11-06T16:00"},"payRange":{"min":80,"max":120},"payType":"blended","payStructure":{"type":"blended","base":{"units":2,"amount":80},"additional":{"units":1,"amount":40}},"hourlyRate":0,"estLaborHours":3,"distance":7.710438601064821},"result":{"eligible":false,"counterOffer":null,"reason":"BLOCKED_KEYWORD","rejectDetails":"Blocked keyword \"monitor\" in description"},"availableBlocks":[{"start":"2026-11-06T17:30:00.000Z","end":"2026-11-07T01:00:00.000Z"},{"start":"2026-11-09T14:00:00.000Z","end":"2026-11-09T15:00:00.000Z"},{"start":"2026-11-09T17:00:00.000Z","end":"2026-11-09T19:30:00.000Z"},{"start":"2026-11-09T22:30:00.000Z","end":"2026-11-10T01:00:00.000Z"},{"start":"2026-11-10T14:00:00.000Z","end":"2026-11-10T15:00:00.000Z"},{"start":"2026-11-10T18:00:00.000Z","end":"2026-11-10T21:30:00.000Z"},{"start":"2026-11-11T00:30:00.000Z","end":"2026-11-11T01:00:00.000Z"}],"busyBlocks":[{"start":"2026-11-06T16:30:00.000Z","end":"2026-11-06T17:30:00.000Z","summary":"Gap"},{"start":"2026-11-09T15:00:00.000Z","end":"2026-11-09T16:30:00.000Z","summary":"Survey FN"},{"start":"2026-11-10T15:00:00.000Z","end":"2026-11-10T18:00:00.000Z","summary":"Granite"},{"start":"2026-11-10T15:00:00.000Z","end":"2026-11-10T18:00:00.000Z","summary":"🔧 05636592 - 1013 Classic Rd | VTM CUT (WM)"},{"start":"2026-11-06T14:00:00.000Z","end":"2026-11-06T17:00:00.000Z","summary":"🔧 04048455-Humacyte INC-EPIK Survey and Install (WM)"},{"start":"2026-11-16T21:30:00.000Z","end":"2026-11-17T00:30:00.000Z","summary":"🔧 Advance Auto Parts - Phone Swap - 4810 Raleigh  NC (WM)"},{"start":"2026-11-10T21:30:00.000Z","end":"2026-11-11T00:30:00.000Z","summary":"🔧 ***Thermo Fisher | Network Cutover Assistance*** (WM)"},{"start":"2026-11-17T17:30:00.000Z","end":"2026-11-17T20:30:00.000Z","summary":"🔧 Rollins/Orkin Pest Control - FortiGate Swap & edgebootPro installation - Ra