m bridge check in problems, etc)\n- Level 2 Escalation -Project Manager: **\\*\\*\\* \\*\\*\\*\\*\\*\\* \\*\\*\\*\\*\\*\\* \\*\\* \\*** \\*\\*\\*\\*\\*\\*\\*\\*\\*\\*\\*\\*\\*\\*  - in case Level 1 not responding -30 min","actions":[]},"isRequestedWindow":false,"time":{"start":"2026-11-02T08:45","end":"2026-11-02T16:45"},"payRange":{"min":55,"max":440},"payType":"hourly","payStructure":null,"hourlyRate":55,"estLaborHours":8,"distance":62.15732762020054},"result":{"eligible":false,"counterOffer":{"shouldCounterOffer":true,"payType":"hourly","counterRate":60,"baseAmount":480,"estHours":8,"travelExpense":90,"payStructure":null,"counterDate":{"start":"2026-11-02T14:00:00.000Z","end":"2026-11-02T14:00:00.000Z","durationMinutes":0}},"reason":"COUNTER_DATES"},"availableBlocks":[{"start":"2026-11-02T14:00:00.000Z","end":"2026-11-03T01:00:00.000Z"},{"start":"2026-11-04T14:00:00.000Z","end":"2026-11-05T01:00:00.000Z"},{"start":"2026-11-05T14:00:00.000Z","end":"2026-11-06T01:00:00.000Z"},{"start":"2026-11-06T14:00:00.000Z","end":"2026-11-07T01:00:00.000Z"}],"busyBlocks":[{"start":"2026-11-03T05:00:00.000Z","end":"2026-11-04T05:00:00.000Z","summary":"Election Day"},{"start":"2026-10-30T13:01:00.000Z","end":"2026-10-30T16:01:00.000Z","summary":"🔧 Budderfly - 171910 - BK-10775 - ROUTER REBOOT - NO EQUIPMENT (WM)"},{"start":"2026-11-17T17:30:00.000Z","end":"2026-11-17T20:30:00.000Z","summary":"🔧 Rollins/Orkin Pest Control - FortiGate Swap & edgebootPro installation - Raleigh, NC (WM)"},{"start":"2026-11-09T19:30:00.000Z","end":"2026-11-09T22:30:00.000Z","summary":"🔧 Rollins/Orkin Pest Control - FortiGate Swap & edgebootPro installation - Raleigh, NC (WM)"},{"start":"2026-10-28T17:00:00.000Z","end":"2026-10-28T21:00:00.000Z","summary":"🔧 Trinity Lower School (WM)"},{"start":"2026-10-28T17:01:00.000Z","end":"2026-10-28T21:01:00.000Z","summary":"🔧 Trinity Gym (WM)"},{"start":"2026-10-28T17:00:00.000Z","end":"2026-10-28T21:00:00.000Z","summary":"🔧 Trinity South Building (WM)"},{"start