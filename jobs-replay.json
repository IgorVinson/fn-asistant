{"job":{"id":20132084,"platform":"FieldNation","company":"expoIT, LLC","title":"Ali - Morrisville, NC - Cat6 Crimped","description":{"html":"<p><span style=\"color: black;\">We have a CAT6 cable feeding a DIA connection to our ION that appears to be improperly crimped, preventing connectivity. This is our new office, and we are moving next week, so we would like to have everything set up by tomorrow. If someone can be dispatched today or tomorrow before 12:00 PM, we would greatly appreciate it.</span></p>","markdown":"We have a CAT6 cable feeding a DIA connection to our ION that appears to be improperly crimped, preventing connectivity. This is our new office, and we are moving next week, so we would like to have everything set up by tomorrow. If someone can be dispatched today or tomorrow before 12:00 PM, we would greatly appreciate it.","actions":[]},"isRequestedWindow":false,"time":{"start":"2026-10-08T16:00","end":"2026-10-08T18:00"},"payRange":{"min":60,"max":120},"payType":"hourly","payStructure":null,"hourlyRate":60,"estLaborHours":2,"distance":5.261245712474521},"result":{"eligible":false,"counterOffer":null,"reason":"PAYMENT_BELOW_MINIMUM","rejectDetails":"Total pay $120 (countered: $120) is below minimum threshold $180"},"availableBlocks":[{"start":"2026-10-09T00:00:00.000Z","end":"2026-10-09T00:00:00.000Z"},{"start":"2026-10-09T13:00:00.000Z","end":"2026-10-09T14:00:00.000Z"},{"start":"2026-10-09T21:00:00.000Z","end":"2026-10-10T00:00:00.000Z"}],"busyBlocks":[{"start":"2026-10-12T04:00:00.000Z","end":"2026-10-13T04:00:00.000Z","summary":"Columbus Day"},{"start":"2026-10-08T17:00:00.000Z","end":"2026-10-08T19:00:00.000Z","summary":"Granite ticket2"},{"start":"2026-10-09T14:00:00.000Z","end":"2026-10-09T17:00:00.000Z","summary":"Granite"},{"start":"2026-10-09T17:00:00.000Z","end":"2026-10-09T21:00:00.000Z","summary":"Vika USCIS biometry"},{"start":"2026-10-09T20:00:00.000Z","end":"2026-10-09T20:30:00.000Z","summary":"Vinson Service_ISS Call"},{"start":"2026