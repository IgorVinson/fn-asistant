Label**: - Within the Part module, select the part usage code from the drop-down list. You will then be asked \"Do you have the return shipping label\". Click the slider to No and Save. A Problem Report will be created requesting the label.\n\n**General Rules**: - Return all returnable unused parts and all returnable used parts to FedEx with 24 hours of Check Out. - Parts belong to AVT/Shyft Services. - Do not leave parts onsite. Parts left onsite are subject to an Admin Process fee.","actions":[]},"isRequestedWindow":false,"time":{"start":"2026-10-05T12:00","end":"2026-10-06T19:00"},"payRange":{"min":80,"max":80},"payType":"fixed","payStructure":null,"hourlyRate":0,"estLaborHours":1.75,"distance":8.403383893034126},"result":{"eligible":false,"counterOffer":null,"reason":"WO_IN_PAST","rejectDetails":"Requested start 10/5/2026, 12:00:00 PM is in the past"},"availableBlocks":[{"start":"2026-10-05T13:00:00.000Z","end":"2026-10-05T16:30:00.000Z"},{"start":"2026-10-06T19:30:00.000Z","end":"2026-10-07T00:00:00.000Z"},{"start":"2026-10-07T17:30:00.000Z","end":"2026-10-08T00:00:00.000Z"},{"start":"2026-10-08T13:00:00.000Z","end":"2026-10-09T00:00:00.000Z"},{"start":"2026-10-09T13:00:00.000Z","end":"2026-10-09T14:00:00.000Z"},{"start":"2026-10-09T20:30:00.000Z","end":"2026-10-10T00:00:00.000Z"}],"busyBlocks":[{"start":"2026-10-06T15:00:00.000Z","end":"2026-10-06T18:00:00.000Z","summary":"Workmarket Roma ticket"},{"start":"2026-10-06T18:00:00.000Z","end":"2026-10-06T19:30:00.000Z","summary":"Dana doctor"},{"start":"2026-10-07T12:00:00.000Z","end":"2026-10-07T14:00:00.000Z","summary":"Vika Ortodont"},{"start":"2026-10-09T14:00:00.000Z","end":"2026-10-09T17:00:00.000Z","summary":"Granite"},{"start":"2026-10-09T17:00:00.000Z","end":"2026-10-09T20:30:00.000Z","summary":"Vika USCIS biometry"},{"start":"2026-10-15T18:00:00.000Z","end":"2026-10-15T21:00:00.000Z","summary":"🔧 05980771-The Edition on Oberlin-EPIK Survey (WM)"},{"start":"2026-10-07T13:30:00.000Z","end":"2026-10-07T17:3