rt\n\nNot allowed : Round neck/ V-neck /sweatshirt/beach dress, 3/4th pant, Hat, Cap, Shorts, unclean shoes and any unclean dress.\n\nDispatch Technician must carry Laptop & Charger, fully charged Mobile and other required equipment\n\nDispatch Technician must be fluent in English (Read, Write and Speak)\n\nNO sunglasses, listening to music with or without headphones (this is fine during lunch break)\n\nContact, Support Engineers details and Equipment details will be shared with Assigned FE Via Email.","actions":[]},"isRequestedWindow":false,"time":{"start":"2026-11-01T09:00","end":"2026-11-01T11:00"},"payRange":{"min":40,"max":80},"payType":"hourly","payStructure":null,"hourlyRate":40,"estLaborHours":2,"distance":50.23257525110406},"result":{"eligible":false,"counterOffer":null,"reason":"PAYMENT_BELOW_MINIMUM","rejectDetails":"Total pay $80 (countered: $120) is below minimum threshold $450"},"availableBlocks":[],"busyBlocks":[],"action":"SKIP","ts":1792597958422}
