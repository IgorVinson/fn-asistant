\\*\\*\\*\\*\\*\\*\\*\\*\\*\\*\\*\\** *to review deliverables before leaving site or job will be considered incomplete and payment may be delayed/decreased. Set job into work done status within 14 days of date of service or may cause delay, decrease, or loss of compensation.*","actions":[]},"isRequestedWindow":false,"time":{"start":"2026-10-29T13:00","end":"2026-10-29T15:00"},"payRange":{"min":127.5,"max":255},"payType":"blended","payStructure":{"type":"blended","base":{"units":2,"amount":127.5},"additional":{"units":2,"amount":63.75}},"hourlyRate":0,"estLaborHours":2,"distance":6.449385384574337},"result":{"eligible":false,"counterOffer":null,"reason":"PAYMENT_BELOW_MINIMUM","rejectDetails":"Total pay $255 is below minimum threshold $300"},"availableBlocks":[{"start":"2026-10-29T21:00:00.000Z","end":"2026-10-30T00:00:00.000Z"},{"start":"2026-10-30T13:00:00.000Z","end":"2026-10-30T13:01:00.000Z"},{"start":"2026-10-30T16:01:00.000Z","end":"2026-10-31T00:00:00.000Z"},{"start":"2026-11-02T14:00:00.000Z","end":"2026-11-03T01:00:00.000Z"}],"busyBlocks":[{"start":"2026-10-31T04:00:00.000Z","end":"2026-11-01T04:00:00.000Z","summary":"Halloween"},{"start":"2026-11-01T04:00:00.000Z","end":"2026-11-02T05:00:00.000Z","summary":"Daylight Saving Time ends"},{"start":"2026-10-29T13:00:00.000Z","end":"2026-10-29T21:00:00.000Z","summary":"Epik Survey"},{"start":"2026-10-29T18:00:00.000Z","end":"2026-10-29T21:00:00.000Z","summary":"Dana ortoped"},{"start":"2026-10-30T13:01:00.000Z","end":"2026-10-30T16:01:00.000Z","summary":"🔧 Budderfly - 171910 - BK-10775 - ROUTER REBOOT - NO EQUIPMENT (WM)"},{"start":"2026-11-17T17:30:00.000Z","end":"2026-11-17T20:30:00.000Z","summary":"🔧 Rollins/Orkin Pest Control - FortiGate Swap & edgebootPro installation - Raleigh, NC (WM)"},{"start":"2026-11-09T19:30:00.000Z","end":"2026-11-09T22:30:00.000Z","summary":"🔧 Rollins/Orkin Pest Control - FortiGate Swap & edgebootPro installation - Raleigh, NC (WM)"},{"start":"2026-10-28T17:00:00.000Z","end":"2026-