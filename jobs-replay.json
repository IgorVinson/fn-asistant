6T08:00","end":"2026-11-16T16:00"},"payRange":{"min":40,"max":320},"payType":"hourly","payStructure":null,"hourlyRate":40,"estLaborHours":8,"distance":7.534358591189322},"result":{"eligible":false,"counterOffer":null,"reason":"BLOCKED_KEYWORD","rejectDetails":"Blocked keyword \"monitor\" in description"},"availableBlocks":[],"busyBlocks":[],"action":"SKIP","ts":1793312343216}
