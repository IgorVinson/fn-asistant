G DEVICES UNTIL AUTHORIZED BY THE GRANITE NOC **<br><br>\t\ti)\tIf there is no power, check the status of the UPS. Tech will bypass the UPS if the battery is no good. UPS battery MUST be bypassed with a SURGE protector. <br>\t\tii)\tIf there is power, check with Granite NOC before any equipment gets rebooted<br><br>\t\tiii)    NOC may need to perform further testing to check fiber uplink and SFP ( to clean and reseat fiber)<br>                                <br><br>\tb)\tVerify with Granite NOC<br>\t<br>3)\tGranite NOC must provide okay to release for the tech.","isRequestedWindow":false,"time":{"start":"2026-09-17T08:00","end":"2026-09-17T12:00"},"payRange":{"min":75,"max":300},"payType":"hourly","payStructure":null,"hourlyRate":75,"estLaborHours":4,"distance":1.2},"result":{"eligible":false,"counterOffer":null,"reason":"WO_IN_PAST","rejectDetails":"Requested start 9/17/2026, 8:00:00 AM is in the past"},"availableBlocks":[{"start":"2026-09-17T13:00:00.000Z","end":"2026-09-18T00:00:00.000Z"},{"start":"2026-09-18T21:00:00.000Z","end":"2026-09-19T00:00:00.000Z"},{"start":"2026-09-21T22:00:00.000Z","end":"2026-09-22T00:00:00.000Z"}],"busyBlocks":[{"start":"2026-09-21T14:00:00.000Z","end":"2026-09-21T22:00:00.000Z","summary":"Busy"},{"start":"2026-09-21T12:00:00.000Z","end":"2026-09-21T14:00:00.000Z","summary":"🔧 ​Concord Police Department - NC ( Phase 2 ) (WM)"},{"start":"2026-09-24T12:00:00.000Z","end":"2026-09-24T14:00:00.000Z","summary":"🔧 USK8 NC-Jacksonville Mall Miniso Retro (WM)"},{"start":"2026-09-22T12:00:00.000Z","end":"2026-09-23T00:00:00.000Z","summary":"🔧 Budderfly - 164043 - BK-6563 - ROUTER REBOOT - NO EQUIPMENT (WM)"},{"start":"2026-09-23T13:00:00.000Z","end":"2026-09-23T16:00:00.000Z","summary":"🔧 02478029-851 - Free People-EPIK Survey (WM)"},{"start":"2026-09-30T14:00:00.000Z","end":"2026-09-30T17:00:00.000Z","summary":"🔧 05974903-Method Townhomes-EPIK Survey (WM)"},{"start":"2026-10-02T14:00:00.000Z","end":"2026-10-02T17:00:00.000Z","summary":"🔧 059