{"job":{"id":20293906,"platform":"FieldNation","company":"buyer name hidden","title":"Wal-GSA-Troubleshoot Phones & Workstations","description":{"html":"**MUST SEE CONFIDENTIAL INFORMATION SECTION / SPECIAL INSTRUCTIONS FOR WORK INSTRUCTIONS**<br/><br/>SCOPE SUMMARY<br/><br/>-Troubleshoot the 2 PCs that are sitting in “computer setup in progress.”  Attempt rebuilding to see if that rectifies the issues. <br/><br/>-Lexmark printer 2 needs to be patched in and confirm online.<br/><br/>-Ensure Avaya phones are online and working.","markdown":"\\*\\*MUST SEE CONFIDENTIAL INFORMATION SECTION / SPECIAL INSTRUCTIONS FOR WORK INSTRUCTIONS\\*\\*  \n  \nSCOPE SUMMARY  \n  \n-Troubleshoot the 2 PCs that are sitting in “computer setup in progress.” Attempt rebuilding to see if that rectifies the issues.   \n  \n-Lexmark printer 2 needs to be patched in and confirm online.  \n  \n-Ensure Avaya phones are online and working.","actions":[]},"isRequestedWindow":false,"time":{"start":"2026-11-06T09:00","end":"2026-11-06T13:00"},"payRange":{"min":45,"max":180},"payType":"hourly","payStructure":null,"hourlyRate":45,"estLaborHours":4,"distance":14.391689505453774},"result":{"eligible":false,"counterOffer":null,"reason":"PAYMENT_BELOW_MINIMUM","rejectDetails":"Total pay $180 (countered: $240) is below minimum threshold $300"},"availableBlocks":[{"start":"2026-11-06T17:00:00.000Z","end":"2026-11-07T01:00:00.000Z"},{"start":"2026-11-09T14:00:00.000Z","end":"2026-11-09T19:30:00.000Z"},{"start":"2026-11-09T22:30:00.000Z","end":"2026-11-10T01:00:00.000Z"},{"start":"2026-11-10T14:00:00.000Z","end":"2026-11-10T21:30:00.000Z"},{"start":"2026-11-11T00:30:00.000Z","end":"2026-11-11T01:00:00.000Z"}],"busyBlocks":[{"start":"2026-11-10T21:30:00.000Z","end":"2026-11-11T00:30:00.000Z","summary":"🔧 ***Thermo Fisher | Network Cutover Assistance*** (WM)"},{"start":"2026-11-05T14:00:00.000Z","end":"2026-11-05T17:00:00.000Z","summary":"🔧 ***Thermo Fisher Scientific | WAN Activations Assistance*** (WM)"},{"