d there.\n\nIf a different device is in Port 29, notify the ROC. The ROC will work with the CVS network team and the vendor technician to move the existing cable to a different port so the MoneyGram DT3 can be moved to Port 29.\n\nNotify the ROC that the configuration is complete and the MoneyGram DT3 network cable has been moved on the main store switch.\n\nThe ROC will remotely test the MoneyGram DT3 device once notified.","actions":[]},"isRequestedWindow":true,"time":{"start":"2026-12-02T09:00","end":"2026-12-02T11:00","latestStart":"2026-12-02T15:00"},"payRange":{"min":100,"max":100},"payType":"fixed","payStructure":null,"hourlyRate":0,"estLaborHours":2,"distance":20.205088472181313},"result":{"eligible":false,"counterOffer":null,"reason":"PAYMENT_BELOW_MINIMUM","rejectDetails":"Total pay $100 is below minimum threshold $450"},"availableBlocks":[{"start":"2026-12-04T14:00:00.000Z","end":"2026-12-05T01:00:00.000Z"}],"busyBlocks":[{"start":"2026-12-01T05:00:00.000Z","end":"2026-12-04T05:00:00.000Z","summary":"Datamax police departments"},{"start":"2026-11-09T19:30:00.000Z","end":"2026-11-09T22:30:00.000Z","summary":"🔧 Rollins/Orkin Pest Control - FortiGate Swap & edgebootPro installation - Raleigh, NC (WM)"},{"start":"2026-11-10T15:00:00.000Z","end":"2026-11-10T18:00:00.000Z","summary":"🔧 05636592 - 1013 Classic Rd | VTM CUT (WM)"},{"start":"2026-11-16T21:30:00.000Z","end":"2026-11-17T00:30:00.000Z","summary":"🔧 Advance Auto Parts - Phone Swap - 4810 Raleigh  NC (WM)"},{"start":"2026-11-10T21:30:00.000Z","end":"2026-11-11T00:30:00.000Z","summary":"🔧 ***Thermo Fisher | Network Cutover Assistance*** (WM)"},{"start":"2026-11-17T17:30:00.000Z","end":"2026-11-17T20:30:00.000Z","summary":"🔧 Rollins/Orkin Pest Control - FortiGate Swap & edgebootPro installation - Raleigh, NC (WM)"},{"start":"2026-11-09T15:00:00.000Z","end":"2026-11-09T17:00:00.000Z","summary":"Dream Finders - Site Survey - Networking"}],"action":"SKIP","ts":1793999984431}
